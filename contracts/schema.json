{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris-regression-memory:behavioral-contract:v1",
  "title": "IRIS behavioral contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "scope",
    "incident",
    "behavior",
    "applicability",
    "required_guards",
    "governance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IRIS-BEH-[0-9]{4}$"
    },
    "title": { "type": "string", "minLength": 8 },
    "status": {
      "type": "string",
      "enum": ["extracted", "reviewed", "approved", "superseded", "deprecated"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "paths"],
      "properties": {
        "products": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kafka_topics": {
              "type": "array",
              "items": { "type": "string" }
            },
            "configuration_keys": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references"],
      "properties": {
        "severity": { "type": "string" },
        "occurred_at": { "type": "string" },
        "culprit_pr": { "type": "string" },
        "fixing_pr": { "type": "string" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["jira", "github", "rca", "confluence"]
              },
              "key": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant", "failure_mechanism"],
      "properties": {
        "invariant": { "type": "string", "minLength": 12 },
        "failure_mechanism": { "type": "string", "minLength": 12 },
        "triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consequences": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strong_anchors", "confidence"],
      "properties": {
        "strong_anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "violation_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "violation_signal_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 2 }
          }
        },
        "violation_line_patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 4, "maxLength": 500 }
        },
        "removal_signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        },
        "excluded_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusion_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "required_guards": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "version"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-(team|maintainers|owners)$" },
        "approved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "review_after": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "governance": { "required": ["owner", "approved_at", "review_after", "version"] }
        }
      }
    }
  ]
}
