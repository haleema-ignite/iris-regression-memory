{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truth-compiler:tenant:v1",
  "title": "Truth Compiler tenant",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "repositories"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,32}$"
    },
    "name": { "type": "string", "minLength": 2 },
    "github_org": { "type": "string" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "default_enforcement": {
      "type": "string",
      "enum": ["warning", "error"]
    }
  }
}
