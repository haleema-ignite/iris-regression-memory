{
  "name": "truth-compiler",
  "version": "1.0.0",
  "private": true,
  "description": "Truth Compiler: learn a GitHub system, compile facts onto Semgrep, CodeRabbit, contracts, and product proofs, and fail when a recorded fact is no longer true. IRIS is tenant zero.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assess": "tsx src/cli.ts assess",
    "compile": "tsx src/cli.ts compile --tenant iris --out tenants/iris/emitters",
    "list": "tsx src/cli.ts list --tenant iris",
    "action": "tsx src/action.ts",
    "mcp": "tsx src/mcp.ts",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run compile && npm run build",
    "evaluate:local": "node scripts/evaluate-local.mjs",
    "trial:local": "node scripts/trial-local.mjs",
    "probe:canonical": "node scripts/canonical-probe.mjs",
    "verify:semgrep": "node scripts/verify-semgrep.mjs"
  },
  "license": "MIT",
  "files": [
    "action.yml",
    "tenants",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "truth-compiler": "dist/cli.cjs",
    "truth-compiler-mcp": "dist/mcp.cjs",
    "iris-regression-memory": "dist/cli.cjs",
    "iris-regression-memory-mcp": "dist/mcp.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.17.1",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
